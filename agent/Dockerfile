# Образ агента разработки. Отдельный от воркера намеренно.
#
# Аналитика (`claude -p`) пишет документы и живёт в воркере без вопросов. Агент
# разработки делает другое: он ИСПОЛНЯЕТ код репозитория — ставит зависимости,
# гоняет тесты, запускает сборку. Внутри воркера это означало бы выполнение
# произвольного кода чужого репозитория рядом с GitHub-токеном и ключом модели.
#
# Поэтому прогон уезжает в одноразовый контейнер: живёт минуты, видит только
# рабочий каталог задачи, умирает вместе с ней. Секреты внутрь передаются
# точечно — ключ модели нужен, токен GitHub нет: коммит, пуш и PR делает воркер
# уже после, своими руками.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates curl \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Версия зафиксирована: агент разработки — не то место, где хочется получить
# другое поведение от того, что молча приехало свежим релизом.
#
# 1.16.0 — версия пакета `openhands` на PyPI. Не путать с версией SDK, которую
# CLI печатает в баннере (там 1.21.0): пин по ней не ставится вовсе.
ARG OPENHANDS_VERSION=1.16.0
# Ставится через uv, а не pip: у pip резолвер разваливается на конфликте
# lmnr/openhands-sdk (ResolutionImpossible), и это же документированный способ
# установки у самого OpenHands.
COPY --from=ghcr.io/astral-sh/uv:0.9.7 /uv /usr/local/bin/uv
# Каталог инструментов вынесен из /root: прогон идёт от непривилегированного
# пользователя, а /root закрыт 0700 — шим в PATH при этом виден, но сам
# интерпретатор за ним прочитать нельзя, и падает это уже на запуске.
ENV UV_TOOL_DIR=/opt/uv-tools \
    UV_TOOL_BIN_DIR=/usr/local/bin
RUN uv tool install --python 3.12 "openhands==${OPENHANDS_VERSION}" \
    && chmod -R a+rX /opt/uv-tools

# Прогон идёт от непривилегированного пользователя: код репозитория исполняется
# здесь, и давать ему root внутри контейнера незачем.
RUN useradd -m -u 10001 agent
USER agent

ENV OPENHANDS_SUPPRESS_BANNER=1 \
    TTY_COMPATIBLE=1

# Постановка приезжает файлом `.task.md` в рабочем каталоге, результат —
# изменения там же. Путь ОТНОСИТЕЛЬНЫЙ: каталог задачи задаётся при запуске
# (`-w`), потому что воркер и раннер делят один том, и у каждой задачи в нём
# своя папка.
ENTRYPOINT ["openhands", "--headless", "--override-with-envs", "-f", ".task.md"]
